{
  "$schema": "../../../../../node_modules/nx-electron/src/validation/maker.schema.json",
  "productName": "LumaScope",
  "electronDist": "./.electron-dist",
  "fileAssociations": [
    {
      "ext": [
        "jpg",
        "jpeg",
        "jxl",
        "png",
        "gif",
        "svg",
        "webp",
        "avif",
        "heif",
        "heic",
        "exr",
        "hdr",
        "tif",
        "tiff",
        "bmp"
      ],
      "role": "Viewer"
    }
  ],
  "nsis": {
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "oneClick": false
  },
  "win": {
    "signExecutable": false,
    "icon": "./apps/desktop/src/assets/lumascope.ico",
    "extraResources": [
      {
        "from": "tools/jxr-wic-prototype/build/Release/jxr-wic-encoder.exe",
        "to": "jxr-wic-encoder.exe"
      },
      {
        "from": "tools/osmand-runtime/stage/helpers",
        "to": "osmand/helpers"
      }
    ]
  },
  "electronLanguages": [
    "en-GB"
  ],
  "files": [
    {
      "from": "desktop",
      "to": "desktop",
      "filter": [
        "thumb-worker.js"
      ]
    }
  ],
  "extraFiles": [
    {
      "from": "LumaScope.default.config.json",
      "to": "."
    }
  ]
}
