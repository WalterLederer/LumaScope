        "HillshadeRegex": "(?:^|\\s)(?:australia|oceania|australia-oceania)\\.sqlitedb$"
      },
      "all": {
        "name": "All",
        "OsmAndRegex": ".*\\.obf$",
        "mapsForgeRegex": ".*\\.map$"
      },
      "none": {
        "name": "None",
        "OsmAndRegex": "(?!)",
        "mapsForgeRegex": "(?!)"
      },
      "custom": {
        "name": "Custom",
        "OsmAndRegex": ".*\\.obf$",
        "mapsForgeRegex": ".*\\.map$"
      }
