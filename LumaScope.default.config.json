        "HillshadeRegex": "(?:^|\\s)centralamerica\\.sqlitedb$"
      },
      "southamerica": {
        "name": "Southamerica",
        "mapsForgeRegex": "^(?:argentina|bolivia|brazil|centro-oeste|nordeste|norte|sudeste|sul|chile|colombia|ecuador|guyana|paraguay|peru|suriname|uruguay|venezuela)\\.map$",
