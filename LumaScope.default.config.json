    "presets": {
      "austria": {
        "name": "Austria",
        "OsmAndRegex": "austria|österreich|osterreich",
        "mapsForgeRegex": "^austria\\.map$",
        "HillshadeRegex": "^Hillshade\\s+Austria(?:\\s|\\.|$)"
      },
      "austria-plus": {
        "name": "Austria+",
        "OsmAndRegex": "austria|österreich|osterreich|germany|deutschland|czech|czechia|tschech|slovakia|slowakei|slovensko|hungary|ungarn|slovenia|slowenien|italy|italien|switzerland|schweiz|liechtenstein",
        "mapsForgeRegex": "^(?:austria|germany|czech-republic|slovakia|hungary|slovenia|italy|switzerland|liechtenstein)\\.map$",
        "HillshadeRegex": "^Hillshade\\s+(?:Austria|Germany|Deutschland|Czechia|Czech-republic|Slovakia|Hungary|Slovenia|Italy|Switzerland|Liechtenstein)(?:\\s|\\.|$)"
      },
      "dach": {
        "name": "DACH",
        "OsmAndRegex": "germany|deutschland|austria|österreich|osterreich|switzerland|schweiz|suisse|svizzera",
        "mapsForgeRegex": "^(?:germany|austria|switzerland)\\.map$",
        "HillshadeRegex": "^Hillshade\\s+(?:Germany|Deutschland|Austria|Switzerland)(?:\\s|\\.|$)"
      },
      "us": {
        "name": "US",
        "OsmAndRegex": "^us[_-]",
        "mapsForgeRegex": "^(?:us-(?:midwest|northeast|south|west)|alabama|alaska-[12]|arizona|arkansas|california|colorado|connecticut|delaware|district-of-columbia|florida|georgia|hawaii|idaho|illinois|indiana|iowa|kansas|kentucky|louisiana|maine|maryland|massachusetts|michigan|minnesota|mississippi|missouri|montana|nebraska|nevada|new-hampshire|new-jersey|new-mexico|new-york|north-carolina|north-dakota|ohio|oklahoma|oregon|pennsylvania|puerto-rico|rhode-island|south-carolina|south-dakota|tennessee|texas|us-virgin-islands|utah|vermont|virginia|washington|west-virginia|wisconsin|wyoming)\\.map$",
        "HillshadeRegex": "^Hillshade\\s+(?:US|United-states)(?:\\s|\\.|$)"
      },
      "europe": {
        "name": "Europe",
        "mapsForgeRegex": "^(?:albania|andorra|austria|azores|belarus|belgium|bosnia-herzegovina|bulgaria|croatia|cyprus|czech-republic|denmark|estonia|faroe-islands|finland|france|georgia|germany|great-britain|greece|guernsey-jersey|hungary|iceland|ireland-and-northern-ireland|isle-of-man|italy|kosovo|latvia|liechtenstein|lithuania|luxembourg|macedonia|malta|moldova|monaco|montenegro|netherlands|norway|poland|portugal|romania|serbia|slovakia|slovenia|spain|sweden|switzerland|turkey|ukraine)\\.map$",
        "OsmAndRegex": "(?:^|[_. -])(?:europe|albania|andorra|austria|belarus|belgium|bosnia|bulgaria|croatia|cyprus|czech|denmark|estonia|faroe|finland|france|georgia|germany|great.?britain|greece|guernsey|hungary|iceland|ireland|isle.?of.?man|italy|kosovo|latvia|liechtenstein|lithuania|luxembourg|macedonia|malta|moldova|monaco|montenegro|netherlands|norway|poland|portugal|romania|serbia|slovakia|slovenia|spain|sweden|switzerland|turkey|ukraine)(?:[_. -]|$)",
        "HillshadeRegex": "^Hillshade\\s+(?:Albania|Andorra|Austria|Belarus|Belgium|Bosnia[- ]Herzegovina|Bulgaria|Croatia|Cyprus|Czech(?:ia|[- ]Republic)?|Denmark|Estonia|Faroe(?:[- ]Islands)?|Finland|France|Georgia|Germany|Great[- ]Britain|Greece|Guernsey(?:[- ]Jersey)?|Hungary|Iceland|Ireland(?:[- ]and[- ]Northern[- ]Ireland)?|Isle[- ]of[- ]Man|Italy|Kosovo|Latvia|Liechtenstein|Lithuania|Luxembourg|Macedonia|Malta|Moldova|Monaco|Montenegro|Netherlands|Norway|Poland|Portugal|Romania|Serbia|Slovakia|Slovenia|Spain|Sweden|Switzerland|Turkey|Ukraine)(?:\\s|\\.|$)"
      },
      "asia": {
