      "austria": {
        "name": "Austria",
        "regex": "austria|österreich|osterreich"
      },
      "austria-plus": {
        "name": "Austria+",
        "regex": "austria|österreich|osterreich|germany|deutschland|czech|czechia|tschech|slovakia|slowakei|slovensko|hungary|ungarn|slovenia|slowenien|italy|italien|switzerland|schweiz|liechtenstein"
      },
      "dach": {
        "name": "DACH",
        "regex": "germany|deutschland|austria|österreich|osterreich|switzerland|schweiz|suisse|svizzera"
      },
      "us": {
        "name": "US",
        "regex": "^us[_-]"
      },
      "europe": {
        "name": "Europe",
        "regex": "(?:^|[_. -])europe(?:[_. -]|$)"
      },
      "all": {
        "name": "All",
        "regex": ".*"
      },
      "none": {
        "name": "None",
        "regex": "(?!)"
      },
      "custom": {
        "name": "Custom",
        "regex": ".*"
      }
    }
