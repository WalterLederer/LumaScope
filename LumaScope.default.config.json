        "mapsForgeRegex": "^(?:afghanistan|armenia|azerbaijan|bangladesh|bhutan|cambodia|east-timor|gcc-states|india|indonesia|iran|iraq|israel-and-palestine|japan|jordan|kazakhstan|kyrgyzstan|laos|lebanon|malaysia-singapore-brunei|maldives|mongolia|myanmar|nepal|north-korea|pakistan|philippines|south-korea|sri-lanka|syria|taiwan|tajikistan|thailand|turkmenistan|uzbekistan|vietnam|yemen)\\.map$",
